# PostgreSQL 접속 문자열 (Neon / Supabase 등)
DATABASE_URL="postgresql://user:password@host:5432/dbname"
# 세션 서명용 비밀키 (32자 이상 랜덤 문자열)
SESSION_SECRET=""
# 서비스 공개 URL (OAuth 리다이렉트에 사용). 끝에 / 없이.
APP_URL="http://localhost:3000"
# Discord Developer Portal > OAuth2
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
# Discord Developer Portal > Bot (Message Content Intent 켜기)
DISCORD_BOT_TOKEN=""
# 참여 가능한 디스코드 서버(길드) ID. 비워두면 서버 검사를 건너뜀
DISCORD_GUILD_ID=""
# 최초 어드민으로 지정할 디스코드 사용자 ID (쉼표로 구분)
ADMIN_DISCORD_IDS=""
# 개발 환경에서만 true. 운영에서는 절대 켜지 마세요.
DEV_LOGIN="false"
