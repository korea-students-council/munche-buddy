# PostgreSQL 접속 문자열 (Neon / Supabase 등)
DATABASE_URL="postgresql://user:password@host:5432/dbname"
# 세션 서명용 비밀키 (32자 이상 랜덤 문자열). 비워 두면 DB 접속 정보로부터 자동으로 만들어요. 직접 정하면 DB 주소를 바꿔도 로그인이 유지돼요.
SESSION_SECRET=""
# 서비스 공개 URL (OAuth 리다이렉트에 사용). 끝에 / 없이.
APP_URL="http://localhost:3000"
# Discord Developer Portal > OAuth2
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
# Discord Developer Portal > Bot (서버 멤버 불러오기를 쓰려면 Server Members Intent 켜기)
DISCORD_BOT_TOKEN=""
# Discord Developer Portal > General Information > Public Key (슬래시 명령 서명 검증용, 공개 값)
DISCORD_PUBLIC_KEY=""
# 매일 7시 자동 공지(크론) 보호용 랜덤 문자열. 없으면 자동 공지만 꺼지고, 어드민의 '지금 미션 공지 실행'은 그대로 써요.
CRON_SECRET=""
# 참여 가능한 디스코드 서버(길드) ID. 비워두면 서버 검사를 건너뜀
DISCORD_GUILD_ID=""
# 최초 어드민으로 지정할 디스코드 사용자 ID (쉼표로 구분)
ADMIN_DISCORD_IDS=""
# 개발 환경에서만 true. 운영에서는 절대 켜지 마세요.
DEV_LOGIN="false"
